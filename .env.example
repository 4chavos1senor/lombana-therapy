
# ==========================================
# LOMBANA THERAPY
# CONFIGURACIÓN DE EJEMPLO
# UNIDAD 3 - SERVICIOS WEB
# ==========================================

# Entorno de ejecución
APP_ENV=development

# Servidor local
LOCAL_URL=http://127.0.0.1:5502

# ==========================================
# SUPABASE
# ==========================================

# URL pública del proyecto
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave publicable
# No colocar una clave secreta
SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE_AQUI

# ==========================================
# SEGURIDAD
# ==========================================

# Origen permitido de desarrollo
ALLOWED_ORIGIN=http://127.0.0.1:5502

# ==========================================
# REGISTROS Y DEPURACIÓN
# ==========================================

LOG_LEVEL=development
